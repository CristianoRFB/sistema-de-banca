name = "sistema-de-banca-api"
main = "src/index.ts"
compatibility_date = "2026-09-29"

[vars]
FIREBASE_PROJECT_ID = "banca-88851"
BANCA_ID = "PREENCHER_ID_DO_DOCUMENTO_BANCAS"
CORS_ORIGINS = "https://SEU_DOMINIO_FINAL"

# After assigning the custom domain, route only API paths through this Worker.
# routes = [{ pattern = "SEU_DOMINIO_FINAL/api/*", zone_name = "SEU_DOMINIO_FINAL" }]

[secrets]
required = ["FIREBASE_SERVICE_ACCOUNT_JSON", "CLIENT_SESSION_PEPPER"]

[[ratelimits]]
name = "CLIENT_RATE_LIMITER"
# Replace with a unique positive integer string for your Cloudflare account.
namespace_id = "1001"

  [ratelimits.simple]
  limit = 60
  period = 60

[triggers]
crons = ["*/15 * * * *"]

[observability]
enabled = true
head_sampling_rate = 1

  [observability.logs]
  enabled = true
  head_sampling_rate = 1

  [observability.traces]
  enabled = true
  head_sampling_rate = 0.05
